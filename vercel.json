{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app/static",
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/workspace", "destination": "/workspace.html" },
    { "source": "/m", "destination": "/mobile.html" },
    { "source": "/offline", "destination": "/offline.html" }
  ]
}
